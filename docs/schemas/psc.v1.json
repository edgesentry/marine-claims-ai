{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "psc.v1"
    },
    "payload": {
      "type": "object",
      "properties": {
        "deficiencies": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "action_code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": "string"
              },
              "inspection_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mou_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "code"
            ],
            "additionalProperties": false
          }
        },
        "prior_deficiencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "action_code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": "string"
              },
              "inspection_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mou_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "code"
            ],
            "additionalProperties": false
          }
        },
        "lookback_months": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "cic_weights": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "mou_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "deficiencies"
      ],
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "grounding": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "source_quote": {
            "type": "string",
            "minLength": 1
          },
          "page_number": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "pdf_coordinates": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "page": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "x0": {
                    "type": "number"
                  },
                  "y0": {
                    "type": "number"
                  },
                  "x1": {
                    "type": "number"
                  },
                  "y1": {
                    "type": "number"
                  }
                },
                "required": [
                  "page",
                  "x0",
                  "y0",
                  "x1",
                  "y1"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source_quote"
        ],
        "additionalProperties": false
      }
    },
    "abstain": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "HUMAN_REVIEW_REQUIRED"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_id",
    "payload",
    "confidence",
    "grounding"
  ],
  "additionalProperties": false
}
