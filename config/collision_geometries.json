    },
    {
      "id": "syn_overtake_starb_quarter",
      "kind": "synthetic",
      "quadrant": "overtaking_starboard",
      "heading_a_deg": 5.0,
      "heading_b_deg": 0.0,
      "true_bearing_a_to_b_deg": 350.0,
      "expected_situation": "overtaking",
      "expected_role_a": "give_way",
      "expected_role_b": "stand_on",
      "expected_mutual_starboard": false,
      "notes": "A approaching from B's starboard quarter (>112.5° abaft B beam)"
    },
    {
      "id": "syn_overtake_port_quarter",
      "kind": "synthetic",
      "quadrant": "overtaking_port",
      "heading_a_deg": 355.0,
      "heading_b_deg": 0.0,
      "true_bearing_a_to_b_deg": 10.0,
      "expected_situation": "overtaking",
      "expected_role_a": "give_way",
      "expected_role_b": "stand_on",
      "expected_mutual_starboard": false,
      "notes": "A approaching from B's port quarter"
    },
    {
      "id": "syn_being_overtaken",
      "kind": "synthetic",
      "quadrant": "overtaking_astern",
      "heading_a_deg": 90.0,
      "heading_b_deg": 90.0,
      "true_bearing_a_to_b_deg": 270.0,
      "expected_situation": "overtaking",
      "expected_role_a": "stand_on",
      "expected_role_b": "give_way",
      "expected_mutual_starboard": false,
      "notes": "B dead astern of A → B overtaking, A stand-on"
    },
    {
      "id": "syn_safe_parallel",
      "kind": "synthetic",
      "quadrant": "safe_passing",
      "heading_a_deg": 0.0,
      "heading_b_deg": 0.0,
      "true_bearing_a_to_b_deg": 90.0,
      "expected_situation": "safe_passing",
      "expected_role_a": null,
      "expected_role_b": null,
      "expected_mutual_starboard": false,
      "notes": "Same course, abeam — no Rule 13/14/15 encounter"
    },
    {
      "id": "syn_safe_diverging",
      "kind": "synthetic",
      "quadrant": "safe_passing",
      "heading_a_deg": 0.0,
      "heading_b_deg": 180.0,
      "true_bearing_a_to_b_deg": 90.0,
      "expected_situation": "safe_passing",
      "expected_role_a": null,
      "expected_role_b": null,
      "expected_mutual_starboard": false,
      "notes": "Reciprocal courses but abeam (not ahead) — not Rule 14; green-to-green / red-to-red style pass"
    },
    {
      "id": "hist_crossing_kii_pattern",
      "kind": "historical_pattern",
      "quadrant": "crossing_starboard",
      "heading_a_deg": 30.0,
      "heading_b_deg": 300.0,
