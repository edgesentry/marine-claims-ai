      "expected_situation": "crossing",
      "expected_role_a": "stand_on",
      "expected_role_b": "give_way",
      "expected_mutual_starboard": false,
      "notes": "Port boundary 247.5° (not overtaking from A)"
    },
    {
      "id": "syn_overtake_astern",
      "kind": "synthetic",
      "quadrant": "overtaking_astern",
      "heading_a_deg": 0.0,
      "heading_b_deg": 0.0,
      "true_bearing_a_to_b_deg": 0.0,
      "expected_situation": "overtaking",
      "expected_role_a": "give_way",
      "expected_role_b": "stand_on",
      "expected_mutual_starboard": false,
