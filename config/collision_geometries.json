      "expected_situation": "crossing",
      "expected_role_a": "give_way",
      "expected_role_b": "stand_on",
      "expected_mutual_starboard": false,
      "source_pattern": "JMAT / civil public holdings: 紀伊水道 横切態勢 (Rule 15 give-way on starboard)",
      "ruling_article": "Art. 15 / Rule 15",
