{
  "version": 1,
  "description": "Synthetic and anonymized historical-pattern collision geometries for COLREGS Rules 13–15 unit tests. No real vessel names or IMO numbers. Thresholds match COLREGS 1972 / 海上衝突予防法 Arts. 13–15.",
  "sources": {
    "rule_text": [
      "https://www.imo.org/en/About/Conventions/Pages/COLREG.aspx",
      "https://elaws.e-gov.go.jp/document?lawid=352AC0000000062"
    ],
    "geometry_patterns": [
      "JMAT public saiketsu fact patterns (relative bearing / statutory article labels)",
      "JTSB marine accident report AIS/radar plot geometry patterns"
    ]
  },
  "conventions": {
    "relative_bearing": "0=ahead, 90=starboard beam, 180=astern, 270=port beam",
    "overtaking_sector_from_overtaken": "(112.5, 247.5) degrees relative bearing of approacher",
    "head_on_course_band": "180 ± 5 degrees",
    "head_on_bearing_band": "± 5 degrees from ahead"
  },
  "cases": [
    {
      "id": "syn_head_on_exact",
      "kind": "synthetic",
      "quadrant": "head_on",
      "heading_a_deg": 0.0,
      "heading_b_deg": 180.0,
      "true_bearing_a_to_b_deg": 0.0,
      "expected_situation": "head_on",
      "expected_role_a": "give_way",
      "expected_role_b": "give_way",
      "expected_mutual_starboard": true,
      "notes": "Exact reciprocal courses, masthead lights in line"
    },
    {
      "id": "syn_head_on_plus5",
      "kind": "synthetic",
      "quadrant": "head_on",
      "heading_a_deg": 90.0,
      "heading_b_deg": 275.0,
      "true_bearing_a_to_b_deg": 90.0,
      "expected_situation": "head_on",
      "expected_role_a": "give_way",
      "expected_role_b": "give_way",
      "expected_mutual_starboard": true,
      "notes": "Course diff 185° within ±5° band; relative bearing dead ahead"
    },
    {
      "id": "syn_head_on_minus5",
      "kind": "synthetic",
      "quadrant": "head_on",
      "heading_a_deg": 45.0,
      "heading_b_deg": 220.0,
      "true_bearing_a_to_b_deg": 45.0,
      "expected_situation": "head_on",
      "expected_role_a": "give_way",
      "expected_role_b": "give_way",
      "expected_mutual_starboard": true,
      "notes": "Course diff 175°; nearly ahead"
    },
    {
      "id": "syn_head_on_bearing_edge",
      "kind": "synthetic",
      "quadrant": "head_on",
      "heading_a_deg": 0.0,
      "heading_b_deg": 180.0,
      "true_bearing_a_to_b_deg": 5.0,
      "expected_situation": "head_on",
      "expected_role_a": "give_way",
      "expected_role_b": "give_way",
      "expected_mutual_starboard": true,
      "notes": "Relative bearing at +5° ahead tolerance"
    },
    {
      "id": "syn_crossing_starb_fine",
      "kind": "synthetic",
      "quadrant": "crossing_starboard",
      "heading_a_deg": 0.0,
      "heading_b_deg": 270.0,
      "true_bearing_a_to_b_deg": 45.0,
      "expected_situation": "crossing",
      "expected_role_a": "give_way",
      "expected_role_b": "stand_on",
      "expected_mutual_starboard": false,
      "notes": "B on A's starboard bow → A give-way (Rule 15)"
    },
    {
      "id": "syn_crossing_starb_beamish",
      "kind": "synthetic",
      "quadrant": "crossing_starboard",
      "heading_a_deg": 0.0,
      "heading_b_deg": 280.0,
      "true_bearing_a_to_b_deg": 100.0,
      "expected_situation": "crossing",
      "expected_role_a": "give_way",
      "expected_role_b": "stand_on",
      "expected_mutual_starboard": false,
      "notes": "Starboard contact forward of 22.5° abaft beam"
    },
    {
      "id": "syn_crossing_starb_1125",
      "kind": "synthetic",
      "quadrant": "crossing_starboard",
      "heading_a_deg": 0.0,
      "heading_b_deg": 240.0,
