      "expected_situation": "crossing",
      "expected_role_a": "give_way",
      "expected_role_b": "stand_on",
      "expected_mutual_starboard": false,
      "notes": "Relative bearing exactly 112.5° (boundary; not yet overtaking from A)"
    },
    {
      "id": "syn_crossing_port_fine",
      "kind": "synthetic",
      "quadrant": "crossing_port",
      "heading_a_deg": 0.0,
      "heading_b_deg": 90.0,
      "true_bearing_a_to_b_deg": 315.0,
      "expected_situation": "crossing",
      "expected_role_a": "stand_on",
      "expected_role_b": "give_way",
      "expected_mutual_starboard": false,
      "notes": "B on A's port bow → A stand-on"
    },
    {
      "id": "syn_crossing_port_beamish",
